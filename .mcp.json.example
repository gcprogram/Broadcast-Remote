{
  "mcpServers": {
    "broadcast-remote": {
      "type": "stdio",
      "command": "python",
      "args": ["/path/to/Broadcast-Remote/pc/broadcast_remote_bridge.py"],
      "env": {
        "BROADCAST_REMOTE_TOKEN": "${BROADCAST_REMOTE_TOKEN}",
        "BROADCAST_REMOTE_URL": "https://192.168.1.20:8443/mcp"
      }
    }
  }
}
